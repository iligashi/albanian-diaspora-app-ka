# Copy to .env.local and fill in real values. Never commit .env.local.

# MongoDB connection string.
# Use "memory" to run against a throwaway in-memory database that is seeded on start
# (handy for demos; data is lost when the dev server stops).
MONGODB_URI=mongodb://127.0.0.1:27017/diaspora-connect

# Secret used to sign session tokens. Must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Public URL of the app (used for absolute links).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Payment provider. Only "test" is implemented today: it approves every charge
# instantly and moves no real money. A Stripe provider plugs into lib/payments.
PAYMENT_PROVIDER=test

# Initial admin account created by `npm run seed`.
SEED_ADMIN_EMAIL=admin@diasporaconnect.test
SEED_ADMIN_PASSWORD=

# Protects /api/cron/daily, which runs recurring plans and birthday reminders.
# Call it daily with: Authorization: Bearer <CRON_SECRET>
# CRON_SECRET=
